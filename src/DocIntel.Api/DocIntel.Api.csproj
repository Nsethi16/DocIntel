<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DocIntel.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Teams.Apps" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <ProjectReference Include="..\DocIntel.Core\DocIntel.Core.csproj" />
    <ProjectReference Include="..\DocIntel.ServiceDefaults\DocIntel.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Diagnostics\DealVelocityDocuments\*.pdf"
                      LogicalName="DocIntel.Api.Diagnostics.DealVelocityDocuments.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Diagnostics\CommercialPortfolio\*.pdf"
                      LogicalName="DocIntel.Api.Diagnostics.CommercialPortfolio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Diagnostics\Fixtures\QA-20261102-*.pdf"
                      LogicalName="DocIntel.Api.Diagnostics.Fixtures.%(Filename)%(Extension)" />
    <None Update="Diagnostics\docintel-directory-probe.v1"
          TargetPath="docintel-directory-probe.v1"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\docintel-decision-probe.v1"
          TargetPath="docintel-decision-probe.v1"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
